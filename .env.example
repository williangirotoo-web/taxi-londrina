# VARIÁVEIS DE AMBIENTE — copiar para .env.local em desenvolvimento
# Na Vercel: configurar em Settings > Environment Variables

# Domínio sem https://, sem www, sem barra final
# Desenvolvimento: localhost:3000
# Produção: seudominio.com.br
NEXT_PUBLIC_DOMAIN=SEU_DOMINIO.com.br

# Google Search Console — verificação de propriedade
NEXT_PUBLIC_GOOGLE_VERIFICATION=COLE_TOKEN_AQUI
